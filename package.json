{
  "name": "portuguese-flashcards",
  "private": true,
  "homepage": "https://KaryRabbit.github.io/portuguese-flashcards",
  "version": "1.0.0",
  "description": "Modern flashcard application for learning European Portuguese",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:sync:android": "npm run build:mobile && cap sync android",
    "cap:sync:ios": "npm run build:mobile && cap sync ios",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/android": "~7.6.6",
    "@capacitor/cli": "~7.6.6",
    "@capacitor/core": "~7.6.6",
    "@capacitor/ios": "~7.6.6",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "playwright": "~1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
